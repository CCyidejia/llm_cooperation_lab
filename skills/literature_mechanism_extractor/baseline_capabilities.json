{
  "schema_version": "game-adapter-capabilities-v2",
  "supported_game_adapters": ["public_goods", "prisoners_dilemma", "trust_game"],
  "supported_topologies": ["group", "dyadic_random_matching", "fixed_network", "dynamic_network", "other"],
  "mechanism_types": [
    "punishment", "reward", "reputation", "social_knowledge", "network_formation",
    "partner_selection", "communication", "history_visibility", "institution_choice", "mixed", "other"
